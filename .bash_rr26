#! /bin/bash

# Bash script file to be inclused in standard .bashrc
# This script setup the ROS2 environment for RoboRama 2026
# 6-can robot code

# NOTE: use ros2 ID defaults for pixi compatibility
# A fix for NAV2
#sudo apt install ros-humble-rmw-cyclonedds-cpp
#export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

#export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# default- open terminal in RoboRama 2026 workspace
cd ~/rr26_ws

# Set Id to my birthday date day number!!!
#export ROS_DOMAIN_ID=18

# set ID to 0 to be compatible with Windows pixi ros2 stuff
# I could not determine how to change the ID in the pixi environment
export ROS_DOMAIN_ID=0

# ROS2 workspace helpers
source /opt/ros/humble/setup.bash
source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash
source install/setup.bash

# Arduino command line
alias arduino-cli=~/local/bin/arduino-cli

# alias to start roboram 2026 ros code
alias rr26="clear; colcon build;\
    source install/setup.bash;\
    ros2 launch rr26_stuff rr26_lc_nav2_bringup_launch.py"

alias kill_ros="source ~/rr26_ws/kill_ros.sh"

alias fox_bridge="ros2 launch foxglove_bridge foxglove_bridge_launch.xml"